{
  "schemaVersion": 1,
  "id": "pearl-bind",
  "version": "${version}",
  "name": "Pearl Bind",
  "description": "Bind a key for ender pearl.",
  "authors": ["Anonymous"],
  "contact": {
    "sources": "https://github.com/battlejesus/meteor-pearlbind-addon"
  },
  "icon": "assets/pearlbind/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.pearlbind.addon.PearlBindAddon"
    ]
  },
  "mixins": [
    "pearlbind.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
